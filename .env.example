# =======================================================
# حارس | HARIS — Arabic Scam Intelligence
# Configuration & Environment Variables
# =======================================================

# Google Gemini API Key
# احصل على المفتاح من Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Name
# النماذج الموصى بها: gemini-2.5-flash أو gemini-2.0-flash أو gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Application Public Name
NEXT_PUBLIC_APP_NAME="حارس | HARIS — Arabic Scam Intelligence"

# Offline Mock Fallback for Demo Safety (true / false)
# في حال الرغبة بتشغيل العرض دون استهلاك الحصة أو في حال انقطاع الشبكة
ENABLE_MOCK_FALLBACK=false
